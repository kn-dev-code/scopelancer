// prisma/schema.prisma

/// Generator Runner
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

/// Database connection
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

/// User model - Configured for Better Auth + App Customizations
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String? // Better Auth maps profile pictures here (Google/GitHub)
  emailVerified Boolean  @default(false)
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth Core Relations
  authSessions Session[]
  accounts     Account[]

  // Application relations
  appSessions AppSession[]
  billings    Billing[]

  // Stripe features
  stripeCustomerId String? @unique
  subscriptionId   String? @unique
  priceId          String?
  status           String?

  @@map("user") // Better Auth maps to lowercase table names internally
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  role          Role     @default(ADMIN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth Core Relations
  authSessions Session[]
  accounts     Account[]

  // Application relations
  appSessions AppSession[]
  billings    Billing[]

  // Stripe features
  stripeCustomerId String? @unique
  subscriptionId   String? @unique
  priceId          String?
  status           String?
}

/// Better Auth Internal Session Model (Tracks active logins)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     Admin?   @relation(fields: [adminId], references: [id])
  adminId   String?

  @@map("session")
}

/// Better Auth Internal Account Model (Links GitHub/Google profiles)
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  admin                 Admin?    @relation(fields: [adminId], references: [id])
  adminId               String?

  @@map("account")
}

/// Better Auth Internal Verification Model (Handles magic links/tokens)
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Your Custom Application Work Session Model (Renamed from Session)
model AppSession {
  id            Int           @id @default(autoincrement())
  title         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id])
  userId        String? // Changed to String to match your User id: String @id
  sessionStatus SessionStatus @default(NOTSTARTED)
  admin         Admin?        @relation(fields: [adminId], references: [id])
  adminId       String?

  @@map("app_session")
}

model Billing {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  admin   Admin?  @relation(fields: [adminId], references: [id])
  adminId String?
}

/// Auth roles
enum Role {
  USER
  ADMIN
}

enum SessionStatus {
  NOTSTARTED
  DIAGRAMING
  COMPLETED
  FAILED
}
